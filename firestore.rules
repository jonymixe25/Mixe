rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "jonyoax95@gmail.com" || 
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read: if true;
      allow write: if isOwner(uid) || isAdmin();
      match /{allSubcollections=**} {
        allow read, write: if isOwner(uid) || isAdmin();
      }
    }

    match /test/connection {
      allow read: if true;
    }

    match /admins/{uid} {
      allow read: if isSignedIn();
      allow write: if request.auth.token.email == "jonyoax95@gmail.com" || isAdmin();
    }

    match /streams/{streamId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn(); 
      allow delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);

      match /{allSubcollections=**} {
        allow read: if true;
        allow write: if isSignedIn();
      }
    }

    match /news/{newsId} {
      allow read: if true;
      allow write: if isAdmin();
      match /comments/{commentId} {
        allow read: if true;
        allow write: if isSignedIn();
      }
    }

    match /alerts/{alertId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /media/{mediaId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /recordings/{recordingId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /chats/{chatId} {
      allow read, write: if isSignedIn();
      match /{allSubcollections=**} {
        allow read, write: if isSignedIn();
      }
    }

    match /calls/{callId} {
      allow read, write: if isSignedIn();
      match /{allSubcollections=**} {
        allow read, write: if isSignedIn();
      }
    }

    match /notifications/{notificationId} {
      allow create: if isSignedIn();
      allow read, update, delete: if isSignedIn() && resource.data.recipientId == request.auth.uid;
    }

    function isValidCamera(data) {
      return data.keys().hasAll(['userId', 'name', 'url', 'type', 'createdAt']) &&
             data.keys().size() <= 8 &&
             data.userId == request.auth.uid &&
             data.name is string && data.name.size() <= 100 &&
             data.url is string && data.url.size() <= 500 &&
             data.type in ['ip', 'wifi', 'bluetooth'];
    }

    match /cameras/{cameraId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidCamera(incoming()) && incoming().createdAt == request.time;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid && 
                    isValidCamera(incoming()) &&
                    !incoming().diff(existing()).affectedKeys().hasAny(['userId', 'createdAt']);
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
  }
}

